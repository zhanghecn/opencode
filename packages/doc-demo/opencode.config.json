{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",

  "permission": {
    "*": "allow",
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "external_directory": {
      "/work/**": "allow",
      "*": "deny"
    }
  },

  "agent": {
    "build": {
      "options": {
        "thinking": {
          "type": "enabled",
          "budgetTokens": 16000
        }
      }
    }
  },

  "skills": {
    "paths": [".opencode/skill/doc-coauthoring"]
  }
}
