# OpenCode Server URL
# Start the server manually in dev mode: bun dev -- serve --port 4096
VITE_OPENCODE_SERVER_URL=http://localhost:4096

# Fixed working directory for document processing
VITE_FIXED_DIRECTORY=/work/documents

# Document parse API configuration
# Can be full parse endpoint (.../api/v1/parse) or server base URL (...)
VITE_DOC_PARSE_API_URL=http://192.168.0.211:1800
VITE_DOC_PARSE_API_TOKEN=

# Default model configuration
VITE_DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514
