DB_PASSWORD=openagents
DB_NAME=openagents

# Gateway
PORT=8080
JWT_SECRET=change-me-in-production

# opencode runtime
OPENCODE_URL=http://localhost:4096
OPENCODE_PORT=4096
OPENCODE_MANAGED=false
AGENTS_ROOT=./agents

# Provider (Kimi API compatible with Anthropic SDK)
ANTHROPIC_API_KEY=sk-kimi-iTmVzeQofVNhi0NVJVn0gY21zEdrbXpEMlSeX6QotEpYL4op46Fb8TWzsQbPSSn1
